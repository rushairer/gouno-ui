{
  "name": "@gouno/ui",
  "version": "0.4.8",
  "description": "Gouno product family UI, themes and administration template",
  "license": "MIT",
  "homepage": "https://rushairer.github.io/gouno-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rushairer/gouno-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rushairer/gouno-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "component-library",
    "tailwindcss",
    "admin"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js"
    },
    "./gouno": {
      "types": "./dist/gouno/index.d.ts",
      "import": "./dist/gouno/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./bootstrap.js": "./dist/bootstrap.js",
    "./fonts/*": "./dist/fonts/*",
    "./brand-icons/*": "./dist/brand-icons/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p showcase/tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "pack": "npm pack",
    "test": "vitest run --environment jsdom",
    "lint:microcopy": "node scripts/check-microcopy-contract.mjs",
    "lint:parity": "node scripts/check-parity-maintenance-contract.mjs",
    "verify": "npm run lint:microcopy && npm run lint:parity && npm run lint:foundation && npm run lint:canonical-audit && npm run lint:source-hygiene && npm run typecheck && npm test && npm run build && npm run showcase:build",
    "package:check": "node scripts/package-check.mjs",
    "release:check": "npm run verify && npm run package:check",
    "prepublishOnly": "npm run release:check",
    "lint:foundation": "node scripts/check-foundation-integrity.mjs",
    "lint:source-hygiene": "node scripts/check-jsx-source-hygiene.mjs",
    "lint:canonical-audit": "node scripts/check-canonical-showcase-audit.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
