{
  "name": "@gouno/ui",
  "version": "0.2.0",
  "type": "module",
  "description": "Gouno product family UI, themes and administration template",
  "license": "MIT",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./patterns": { "types": "./dist/patterns/index.d.ts", "import": "./dist/patterns/index.js" },
    "./gouno": { "types": "./dist/gouno/index.d.ts", "import": "./dist/gouno/index.js" },
    "./theme": { "types": "./dist/theme/index.d.ts", "import": "./dist/theme/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./bootstrap.js": "./dist/bootstrap.js",
    "./fonts/*": "./dist/fonts/*"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p showcase/tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "pack": "npm pack",
    "test": "vitest run --environment jsdom"
  },
  "peerDependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
